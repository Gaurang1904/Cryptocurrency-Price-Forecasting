# Ignore data files
*.csv
!results_legacy.csv
*.xlsx
*.parquet
data/

# Trained models are committed so predict.py runs out-of-box (small artifacts).
# Regenerate any with `python -m tree.lgbm` etc. Ignore backtest cv dumps only.
models/_cv_*
# big tree artifacts - regenerate with `python -m tree.lgbm`
models/*.joblib

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
.venv/
env/

# Ignore system/IDE files
.DS_Store
Thumbs.db
*.log
.vscode/
plots/
report_by_coin.csv
.worktrees/
